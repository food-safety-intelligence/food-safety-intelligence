# Copy this to .env (gitignored) and fill in.

# Where pipeline data lives. Local path by default; set to an s3:// base to run
# ingest / feature build / scoring against S3 (read/written via foodsafety.io.storage).
FOODSAFETY_DATA_DIR=./data
# FOODSAFETY_DATA_DIR=s3://food-safety-intelligence-data

# Where the web-app JSON (scores.json, inspection_history.json, methodology.json) is
# written. Defaults to the committed app/public/data bundle; set to the S3 prefix to
# publish there instead.
# FOODSAFETY_WEB_APP_DATA_DIR=s3://food-safety-intelligence-data/web-app-data

# Where the deployed Next.js app READS its JSON from. The app does an SDK GetObject on
# s3://<FSI_S3_BUCKET>/web-app-data/<file> at request time (app/src/lib/scores-server.ts),
# falling back to the committed mock fixture if S3 is unreachable. Defaults below; for
# production set these in the Amplify/Vercel env, not here. Creds come from the runtime's
# attached IAM role (no keys in this repo).
# FSI_S3_BUCKET=food-safety-intelligence-data
# AWS_REGION=us-east-1

# Optional: Socrata app token. SODA endpoints work without one, but tokens get
# higher rate limits. Register at https://data.cityofchicago.org and paste below.
SODA_APP_TOKEN=
