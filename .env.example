# Copy this to .env (gitignored) and fill in.
# Only set FSI_DATA_DIR if you want data to live outside ./data/.

FOODSAFETY_DATA_DIR=./data

# Optional: Socrata app token. SODA endpoints work without one, but tokens get
# higher rate limits. Register at https://data.cityofchicago.org and paste below.
SODA_APP_TOKEN=
