{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "foodsafety",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "foodsafety"
  },
  "runtimes": [
    {
      "name": "foodsafetyagent",
      "build": "CodeZip",
      "entrypoint": "entrypoint.py",
      "codeLocation": "../agents/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "DATA_BUCKET_REGION",
          "value": "us-east-1"
        },
        {
          "name": "DATA_BUCKET",
          "value": "food-safety-intelligence-data"
        },
        {
          "name": "DATA_PREFIX",
          "value": "web-app-data"
        },
        {
          "name": "FSI_BEDROCK_GUARDRAIL_ID",
          "value": "uti5o4ov79hu"
        },
        {
          "name": "FSI_BEDROCK_GUARDRAIL_VERSION",
          "value": "1"
        }
      ]
    }
  ],
  "memories": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "httpGateways": [],
  "harnesses": [],
  "datasets": []
}